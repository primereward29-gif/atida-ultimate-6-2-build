name: Build ATIDA APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Set up JDK 17
        uses: actions/setup-java@v5
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Set up Node 24
        uses: actions/setup-node@v5
        with:
          node-version: '24'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Make gradlew executable
        run: chmod +x ATIDA_ULTIMATE_6.1_Android_Project/gradlew

      - name: Build Debug APK
        working-directory: ATIDA_ULTIMATE_6.1_Android_Project
        run: ./gradlew assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: ATIDA-6.2-APK
          path: ATIDA_ULTIMATE_6.1_Android_Project/app/build/outputs/apk/debug/app-debug.apk
